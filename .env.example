SECRET_KEY=your-secret-key-here

# Database configuration
# For PostgreSQL (recommended for production with concurrent access):
# DATABASE_URL=postgresql://username:password@localhost:5432/storage_dashboard
# For SQLite (not recommended for production with multiple workers):
DATABASE_URL=sqlite:///storage_dashboard.db

# PostgreSQL credentials (only needed when using PostgreSQL)
POSTGRES_DB=storage_dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=your-postgres-password-here

FLASK_ENV=development
SSL_VERIFY=false
TZ=Europe/Berlin

# --- Optional: REST-API absichern (alle /api/* außer /api/health) ---
# API_ACCESS_TOKEN=generate-a-long-random-secret

# --- Optional: Hintergrund-Jobs (mehrere Gunicorn-Worker) ---
# BACKGROUND_JOBS_ENABLED=1
# BACKGROUND_JOB_LOCKFILE=/run/storage-dashboard/background.lock

# --- Optional: Snapshot-Collector (PostgreSQL) ---
# SNAP_COLLECTOR_DB_LOCK_TIMEOUT_MS=3000
# SNAP_COLLECTOR_DB_STATEMENT_TIMEOUT_MS=0

# --- Optional: Navbar-Alerts-Cache ---
# OPEN_ALERTS_CACHE_SECONDS=30
