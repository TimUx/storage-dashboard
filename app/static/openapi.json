{
  "openapi": "3.0.3",
  "info": {
    "title": "Storage Dashboard API",
    "description": "REST API des Storage Dashboards – liefert Statusinformationen und Verwaltungsfunktionen für alle angebundenen Storage-Systeme.",
    "version": "1.2.0",
    "contact": {
      "name": "Timo Braun",
      "url": "https://github.com/TimUx/storage-dashboard",
      "email": "github@timobraun.de"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Lokale Instanz"
    }
  ],
  "tags": [
    {
      "name": "Dashboard",
      "description": "Haupt-Dashboard (HTML)"
    },
    {
      "name": "Systems",
      "description": "Storage-Systeme – Statusabfragen"
    },
    {
      "name": "Alerts",
      "description": "Alert-Verwaltung – Abfragen und Bestätigungen von Storage-Alerts"
    },
    {
      "name": "Capacity",
      "description": "Kapazitätsreport"
    },
    {
      "name": "Admin",
      "description": "Admin-Bereich (erfordert Anmeldung)"
    },
    {
      "name": "Backup",
      "description": "Backup & Restore – Export und Import aller Einstellungen, Systeme, Zertifikate und Tags"
    },
    {
      "name": "DR",
      "description": "Disaster Recovery Planner – DR-Topologie, Runbooks, Workflows und CLI-Befehle"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Haupt-Dashboard",
        "description": "Gibt das Haupt-Dashboard als HTML-Seite zurück. Per Standard wird die asynchrone Variante geladen (async=true), bei der die Systemdaten über /api/cached-status nachgeladen werden.",
        "parameters": [
          {
            "name": "async",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "true"
            },
            "description": "Wenn true, wird das Dashboard mit Platzhaltern gerendert und die Daten asynchron per JavaScript geladen."
          }
        ],
        "responses": {
          "200": {
            "description": "HTML-Seite des Dashboards",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/api/systems": {
      "get": {
        "tags": [
          "Systems"
        ],
        "summary": "Alle Storage-Systeme auflisten",
        "description": "Gibt alle konfigurierten Storage-Systeme (aktiv und inaktiv) als JSON-Array zurück.",
        "responses": {
          "200": {
            "description": "Liste der Storage-Systeme",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StorageSystem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "tags": [
          "Systems"
        ],
        "summary": "Live-Status aller aktiven Systeme",
        "description": "Fragt den Gesundheitsstatus aller aktivierten Storage-Systeme **live** ab (direkte API-Calls zu den Systemen). Kann bei vielen Systemen einige Sekunden dauern.",
        "responses": {
          "200": {
            "description": "Liste der System-Status-Objekte",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SystemStatusResult"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/systems/{system_id}/status": {
      "get": {
        "tags": [
          "Systems"
        ],
        "summary": "Live-Status eines einzelnen Systems",
        "description": "Fragt den Gesundheitsstatus eines einzelnen Storage-Systems **live** ab.",
        "parameters": [
          {
            "name": "system_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID des Storage-Systems"
          }
        ],
        "responses": {
          "200": {
            "description": "Status des angegebenen Systems",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResult"
                }
              }
            }
          },
          "404": {
            "description": "System nicht gefunden"
          }
        }
      }
    },
    "/api/cached-status": {
      "get": {
        "tags": [
          "Systems"
        ],
        "summary": "Gecachter Status aller aktiven Systeme",
        "description": "Gibt den zuletzt vom Hintergrund-Service gespeicherten Status aller aktiven Systeme zurück. Kein direkter API-Call zu den Storage-Systemen – sehr schnelle Antwort. Jeder Eintrag enthält den Zeitstempel `fetched_at`.",
        "responses": {
          "200": {
            "description": "Liste der gecachten System-Status-Objekte",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CachedStatusResult"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/trigger-status-refresh": {
      "post": {
        "tags": [
          "Systems"
        ],
        "summary": "Sofortige Statusaktualisierung auslösen",
        "description": "Löst eine sofortige, synchrone Statusaktualisierung aller aktiven Systeme aus. Wartet auf Abschluss und gibt die frischen Daten zurück.",
        "responses": {
          "200": {
            "description": "Aktualisierte Status-Daten",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CachedStatusResult"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/alerts": {
      "get": {
        "tags": [
          "Alerts"
        ],
        "summary": "Aktuelle Alerts aller Systeme",
        "description": "Gibt alle offenen Alerts aus dem StatusCache als JSON zurück. Wird von der Alerts-Seite für Auto-Refresh verwendet.",
        "responses": {
          "200": {
            "description": "Liste aller aktuellen Alerts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/alerts/state": {
      "post": {
        "tags": [
          "Alerts"
        ],
        "summary": "Alert-Status aktualisieren (Acknowledge / Assignee / Kommentar)",
        "description": "Aktualisiert den Bearbeitungsstatus eines oder mehrerer Alerts. Unterstützt Bulk-Updates über eine Liste von Alert-Keys.\n\nAlert-Keys haben das Format `system_name|alert_id|title`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertStateRequest"
              },
              "example": {
                "alert_keys": [
                  "mein-system|42|Drive Failure"
                ],
                "acknowledged": true,
                "assignee": "Max Müller",
                "comment": "Wird untersucht"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Anzahl der aktualisierten Alert-Einträge",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "updated": {
                      "type": "integer",
                      "description": "Anzahl der aktualisierten Einträge"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Ungültige Anfrage – alert_keys fehlt oder ist kein Array"
          }
        }
      }
    },
    "/api/alerts/assignees": {
      "get": {
        "tags": [
          "Alerts"
        ],
        "summary": "Bearbeiter-Verlauf abrufen",
        "description": "Gibt alle gespeicherten Bearbeiternamen für die Autocomplete-Funktion zurück, sortiert nach zuletzt verwendet.",
        "responses": {
          "200": {
            "description": "Liste der Bearbeiternamen",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "Max Müller",
                    "Anna Schmidt"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/alerts/assignees/{name}": {
      "delete": {
        "tags": [
          "Alerts"
        ],
        "summary": "Bearbeiter aus dem Verlauf entfernen",
        "description": "Löscht einen Bearbeiternamen aus der Autocomplete-Historie.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Name des zu löschenden Bearbeiters"
          }
        ],
        "responses": {
          "200": {
            "description": "Bestätigung der Löschung",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "string",
                      "description": "Name des gelöschten Bearbeiters"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/systems/{system_id}/details": {
      "get": {
        "tags": [
          "Systems"
        ],
        "summary": "Detailansicht eines Systems",
        "description": "Gibt die HTML-Detailansicht eines einzelnen Storage-Systems zurück.",
        "parameters": [
          {
            "name": "system_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID des Storage-Systems"
          }
        ],
        "responses": {
          "200": {
            "description": "HTML-Detailseite des Systems",
            "content": {
              "text/html": {}
            }
          },
          "404": {
            "description": "System nicht gefunden"
          }
        }
      }
    },
    "/capacity/": {
      "get": {
        "tags": [
          "Capacity"
        ],
        "summary": "Kapazitätsreport",
        "description": "Gibt den Kapazitätsreport als HTML-Seite zurück.",
        "responses": {
          "200": {
            "description": "HTML-Seite des Kapazitätsreports",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/admin": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Admin-Dashboard",
        "description": "Gibt das Admin-Dashboard zurück. Erfordert Anmeldung.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "HTML-Seite des Admin-Dashboards"
          },
          "302": {
            "description": "Weiterleitung zur Login-Seite wenn nicht angemeldet"
          }
        }
      }
    },
    "/admin/login": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Admin-Login-Seite",
        "description": "Gibt die Login-Seite des Admin-Bereichs zurück.",
        "responses": {
          "200": {
            "description": "HTML Login-Seite"
          }
        }
      },
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Admin-Login",
        "description": "Verarbeitet die Anmeldung im Admin-Bereich.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Weiterleitung nach erfolgreichem Login oder zurück bei Fehler"
          }
        }
      }
    },
    "/admin/logout": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Admin-Logout",
        "description": "Meldet den aktuellen Admin-Benutzer ab.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "302": {
            "description": "Weiterleitung zur Login-Seite"
          }
        }
      }
    },
    "/admin/docs": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "API-Einrichtungsdokumentation",
        "description": "Zeigt die Dokumentation zur Einrichtung von API-Zugängen für alle unterstützten Storage-Systeme.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "HTML-Dokumentationsseite"
          }
        }
      }
    },
    "/admin/swagger": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Swagger UI",
        "description": "Interaktive API-Dokumentation (Swagger UI) für das Storage Dashboard.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Swagger UI HTML-Seite"
          }
        }
      }
    },
    "/admin/settings": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Einstellungsseite anzeigen",
        "description": "Gibt die Einstellungsseite des Admin-Bereichs zurück (Design, Logs, Zertifikate, API-Zugänge, Proxy, System, Backup).",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "HTML-Einstellungsseite"
          },
          "302": {
            "description": "Weiterleitung zur Login-Seite wenn nicht angemeldet"
          }
        }
      },
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Einstellungen speichern",
        "description": "Speichert die Einstellungen (Design, Logs, API-Zugänge, Proxy, System). Multipart-Form mit optionalem Logo-Upload.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "company_name": {
                    "type": "string"
                  },
                  "primary_color": {
                    "type": "string",
                    "example": "#A70240"
                  },
                  "secondary_color": {
                    "type": "string",
                    "example": "#BED600"
                  },
                  "accent_color": {
                    "type": "string",
                    "example": "#0098DB"
                  },
                  "logo": {
                    "type": "string",
                    "format": "binary"
                  },
                  "max_logs_per_system": {
                    "type": "integer"
                  },
                  "log_retention_days": {
                    "type": "integer"
                  },
                  "min_log_level": {
                    "type": "string",
                    "enum": [
                      "DEBUG",
                      "INFO",
                      "WARNING",
                      "ERROR",
                      "CRITICAL"
                    ]
                  },
                  "dashboard_refresh_interval": {
                    "type": "integer",
                    "enum": [
                      1,
                      5,
                      15,
                      30,
                      60
                    ]
                  },
                  "timezone": {
                    "type": "string",
                    "example": "Europe/Berlin"
                  },
                  "pure1_display_name": {
                    "type": "string"
                  },
                  "pure1_app_id": {
                    "type": "string"
                  },
                  "pure1_private_key": {
                    "type": "string"
                  },
                  "pure1_private_key_passphrase": {
                    "type": "string"
                  },
                  "pure1_public_key": {
                    "type": "string"
                  },
                  "proxy_http": {
                    "type": "string"
                  },
                  "proxy_https": {
                    "type": "string"
                  },
                  "proxy_no_proxy": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Weiterleitung zurück zur Einstellungsseite nach dem Speichern"
          }
        }
      }
    },
    "/admin/export": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Storage-Systeme exportieren",
        "description": "Exportiert alle konfigurierten Storage-Systeme (ohne Zugangsdaten) als JSON-Datei.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "JSON-Datei mit den exportierten Systemen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemsExport"
                }
              }
            }
          }
        }
      }
    },
    "/admin/import": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Import-Seite anzeigen",
        "description": "Gibt die Importseite für Storage-Systeme zurück.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "HTML-Importseite"
          }
        }
      },
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Storage-Systeme importieren",
        "description": "Importiert Storage-Systeme aus einer zuvor exportierten JSON-Datei. Bereits vorhandene Systeme (gleicher Name) werden übersprungen.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "import_file"
                ],
                "properties": {
                  "import_file": {
                    "type": "string",
                    "format": "binary",
                    "description": "JSON-Exportdatei der Storage-Systeme"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Weiterleitung zur Import-Seite mit Ergebnis-Flash-Meldung"
          }
        }
      }
    },
    "/admin/backup/export": {
      "get": {
        "tags": [
          "Backup"
        ],
        "summary": "Full-Backup herunterladen",
        "description": "Exportiert **alle** Dashboard-Daten in eine einzige JSON-Datei:\n- Allgemeine Einstellungen (Design, Logs, System)\n- Pure1-Zugangsdaten (im Klartext – Datei sicher aufbewahren!)\n- Proxy-Konfiguration\n- Alle Storage-Systeme inkl. Zugangsdaten\n- SSL-Zertifikate\n- Tag-Gruppen und Tags\n\nDie Backup-Datei kann über `POST /admin/backup/import` wieder eingespielt werden.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Full-Backup als JSON-Datei (Download)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackupPayload"
                }
              }
            },
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "description": "attachment; filename=\"storage_dashboard_backup_YYYYMMDD_HHMMSS.json\""
              }
            }
          },
          "302": {
            "description": "Weiterleitung bei Fehler (mit Flash-Meldung)"
          }
        }
      }
    },
    "/admin/backup/import": {
      "post": {
        "tags": [
          "Backup"
        ],
        "summary": "Backup einspielen (Restore)",
        "description": "Stellt Einstellungen, Systeme, Zertifikate und Tags aus einer zuvor erstellten Full-Backup-Datei wieder her.\n\n**Restore-Verhalten:**\n- **Einstellungen:** werden vollständig überschrieben\n- **Systeme / Zertifikate / Tags:** bereits vorhandene Einträge (gleicher Name) werden übersprungen (sicheres Zusammenführen)\n\nNach dem Einspielen wird auf die Einstellungsseite weitergeleitet.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "backup_file"
                ],
                "properties": {
                  "backup_file": {
                    "type": "string",
                    "format": "binary",
                    "description": "JSON-Backup-Datei (.json), erstellt mit GET /admin/backup/export"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Weiterleitung zur Einstellungsseite mit Erfolgs- oder Fehlermeldung (Flash)"
          }
        }
      }
    },
    "/dr/": {
      "get": {
        "tags": [
          "DR"
        ],
        "summary": "DR Planner Seite",
        "description": "Gibt die DR Planner HTML-Seite zurück.",
        "responses": {
          "200": {
            "description": "HTML-Seite des DR Planners",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/dr/api/topology": {
      "get": {
        "tags": [
          "DR"
        ],
        "summary": "DR Topologie-Übersicht",
        "description": "Gibt eine Übersicht aller gefundenen DR-Beziehungen aus dem aktuellen Build zurück.",
        "responses": {
          "200": {
            "description": "DR Topologie-Daten",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "build": {
                      "type": "object",
                      "nullable": true
                    },
                    "relationships": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "stale": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/dr/api/system/{system_name}": {
      "get": {
        "tags": [
          "DR"
        ],
        "summary": "DR System Details",
        "description": "Gibt alle DR-Artefakte (Topologie, Workflow, Runbook, Befehle, Diagramme) für ein bestimmtes System zurück.",
        "parameters": [
          {
            "name": "system_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "planned_failover",
                "failback"
              ],
              "default": "planned_failover"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "DR System-Detaildaten",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "System oder Build nicht gefunden"
          }
        }
      }
    },
    "/dr/api/architecture/{system_name}": {
      "get": {
        "tags": [
          "DR"
        ],
        "summary": "DR Architektur-Daten",
        "description": "Gibt das DR-Topologiemodell und das Architekturdiagramm für ein System zurück.",
        "parameters": [
          {
            "name": "system_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Architekturdiagramm und Topologiedaten",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Nicht gefunden"
          }
        }
      }
    },
    "/dr/api/workflow/{system_name}": {
      "get": {
        "tags": [
          "DR"
        ],
        "summary": "DR Workflow-Definitionen",
        "description": "Gibt die DR-Workflow-Schritte und das Workflow-Diagramm für ein System zurück.",
        "parameters": [
          {
            "name": "system_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "planned_failover",
                "failback"
              ],
              "default": "planned_failover"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workflow-Schritte und Diagramm",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Nicht gefunden"
          }
        }
      }
    },
    "/dr/api/runbook/{system_name}": {
      "get": {
        "tags": [
          "DR"
        ],
        "summary": "DR Runbook",
        "description": "Gibt das strukturierte DR-Runbook für ein System zurück.",
        "parameters": [
          {
            "name": "system_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "planned_failover",
                "failback"
              ],
              "default": "planned_failover"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Runbook-Sektionen und Schritte",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Nicht gefunden"
          }
        }
      }
    },
    "/dr/api/commands/{system_name}": {
      "get": {
        "tags": [
          "DR"
        ],
        "summary": "DR CLI-Befehlssatz",
        "description": "Gibt die generierten CLI-Befehle für ein DR-System zurück.",
        "parameters": [
          {
            "name": "system_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "planned_failover",
                "failback"
              ],
              "default": "planned_failover"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CLI-Befehlssatz",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Nicht gefunden"
          }
        }
      }
    },
    "/dr/api/build-status": {
      "get": {
        "tags": [
          "DR"
        ],
        "summary": "DR Build-Status",
        "description": "Gibt Metadaten über den letzten DR-Build zurück.",
        "responses": {
          "200": {
            "description": "Build-Metadaten",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "build": {
                      "type": "object",
                      "nullable": true
                    },
                    "stale": {
                      "type": "boolean"
                    },
                    "next_scheduled_build": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true
                    },
                    "total_builds": {
                      "type": "integer"
                    },
                    "build_interval_seconds": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/dr/api/rebuild": {
      "post": {
        "tags": [
          "DR"
        ],
        "summary": "DR Rebuild auslösen",
        "description": "Löst einen manuellen DR-Rebuild aus (Neuentdeckung und Neugenerierung aller DR-Artefakte).",
        "responses": {
          "200": {
            "description": "Rebuild wurde ausgelöst",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Fehler beim Auslösen des Rebuilds"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session",
        "description": "Flask-Login Session-Cookie (nach erfolgreichem Login unter /admin/login)"
      }
    },
    "schemas": {
      "StorageSystem": {
        "type": "object",
        "description": "Konfiguriertes Storage-System",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Eindeutige ID"
          },
          "name": {
            "type": "string",
            "description": "Systemname"
          },
          "vendor": {
            "type": "string",
            "enum": [
              "pure",
              "netapp-ontap",
              "netapp-storagegrid",
              "dell-datadomain"
            ],
            "description": "Hersteller"
          },
          "ip_address": {
            "type": "string",
            "description": "IP-Adresse oder Hostname"
          },
          "port": {
            "type": "integer",
            "description": "API-Port"
          },
          "enabled": {
            "type": "boolean",
            "description": "Ob das System aktiv ist"
          },
          "cluster_type": {
            "type": "string",
            "nullable": true,
            "enum": [
              "ha",
              "active-cluster",
              "metrocluster",
              "local",
              "multi-site",
              "single-site",
              null
            ],
            "description": "Cluster-Typ"
          },
          "os_version": {
            "type": "string",
            "nullable": true,
            "description": "Betriebssystem-Version"
          },
          "api_version": {
            "type": "string",
            "nullable": true,
            "description": "API-Version"
          },
          "node_count": {
            "type": "integer",
            "nullable": true,
            "description": "Anzahl Nodes"
          },
          "site_count": {
            "type": "integer",
            "nullable": true,
            "description": "Anzahl Sites (StorageGRID)"
          }
        }
      },
      "HealthStatus": {
        "type": "object",
        "description": "Gesundheitsstatus eines Storage-Systems",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "online",
              "error",
              "unknown"
            ],
            "description": "Gesamtstatus"
          },
          "hardware_status": {
            "type": "string",
            "enum": [
              "ok",
              "warning",
              "error",
              "unknown"
            ],
            "description": "Hardware-Status"
          },
          "cluster_status": {
            "type": "string",
            "enum": [
              "ok",
              "warning",
              "error",
              "unknown"
            ],
            "description": "Cluster-Status"
          },
          "alerts": {
            "type": "integer",
            "description": "Anzahl aktiver Alerts"
          },
          "capacity_total_tb": {
            "type": "number",
            "format": "float",
            "description": "Gesamtkapazität in TB"
          },
          "capacity_used_tb": {
            "type": "number",
            "format": "float",
            "description": "Belegte Kapazität in TB"
          },
          "capacity_percent": {
            "type": "number",
            "format": "float",
            "description": "Belegung in Prozent"
          },
          "error": {
            "type": "string",
            "nullable": true,
            "description": "Fehlermeldung (falls vorhanden)"
          }
        }
      },
      "SystemStatusResult": {
        "type": "object",
        "description": "Kombination aus System-Konfiguration und Live-Status",
        "properties": {
          "system": {
            "$ref": "#/components/schemas/StorageSystem"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        }
      },
      "CachedStatusResult": {
        "type": "object",
        "description": "Kombination aus System-Konfiguration, gecachtem Status und Zeitstempel",
        "properties": {
          "system": {
            "$ref": "#/components/schemas/StorageSystem"
          },
          "status": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/HealthStatus"
              },
              {
                "type": "null"
              }
            ],
            "description": "Status aus dem Cache (null wenn noch kein Cache vorhanden)"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Zeitpunkt der letzten Cache-Aktualisierung (UTC ISO 8601)"
          }
        }
      },
      "Alert": {
        "type": "object",
        "description": "Einzelner Alert eines Storage-Systems (normalisiertes Format)",
        "properties": {
          "system_name": {
            "type": "string",
            "description": "Name des betroffenen Storage-Systems"
          },
          "vendor": {
            "type": "string",
            "description": "Hersteller des Systems"
          },
          "alert_id": {
            "type": "string",
            "description": "System-interne Alert-ID"
          },
          "alert_key": {
            "type": "string",
            "description": "Eindeutiger Schlüssel: system_name|alert_id|title"
          },
          "title": {
            "type": "string",
            "description": "Kurztitel des Alerts"
          },
          "details": {
            "type": "string",
            "description": "Ausführliche Beschreibung"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "critical",
              "emergency",
              "unknown"
            ],
            "description": "Schweregrad"
          },
          "error_code": {
            "type": "string",
            "description": "Herstellerspezifischer Fehlercode"
          },
          "timestamp": {
            "type": "string",
            "description": "Zeitstempel des Alerts (ISO 8601 oder herstellerspezifisch)"
          },
          "component": {
            "type": "string",
            "description": "Betroffene Komponente"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Zeitpunkt der letzten Cache-Abfrage"
          },
          "acknowledged": {
            "type": "boolean",
            "description": "Ob der Alert bestätigt wurde"
          },
          "assignee": {
            "type": "string",
            "nullable": true,
            "description": "Zugewiesener Bearbeiter"
          },
          "comment": {
            "type": "string",
            "nullable": true,
            "description": "Bearbeiterkommentar"
          }
        }
      },
      "AlertsResponse": {
        "type": "object",
        "description": "Antwort des /api/alerts Endpoints",
        "properties": {
          "alerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Alert"
            },
            "description": "Liste aller aktuellen Alerts"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Zeitstempel der jüngsten Cache-Aktualisierung (UTC ISO 8601)"
          }
        }
      },
      "AlertStateRequest": {
        "type": "object",
        "description": "Anfrage zum Aktualisieren des Bearbeitungsstatus eines oder mehrerer Alerts",
        "required": [
          "alert_keys"
        ],
        "properties": {
          "alert_keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Liste der Alert-Schlüssel (system_name|alert_id|title)",
            "example": [
              "mein-system|42|Drive Failure"
            ]
          },
          "acknowledged": {
            "type": "boolean",
            "description": "Bestätigungsstatus – weglassen um unverändert zu lassen"
          },
          "assignee": {
            "type": "string",
            "nullable": true,
            "description": "Bearbeiter zuweisen – null zum Löschen, weglassen um unverändert zu lassen"
          },
          "comment": {
            "type": "string",
            "nullable": true,
            "description": "Kommentar setzen – null zum Löschen, weglassen um unverändert zu lassen"
          }
        }
      },
      "BackupSettings": {
        "type": "object",
        "description": "Einstellungen-Abschnitt einer Backup-Datei",
        "properties": {
          "primary_color": {
            "type": "string",
            "example": "#A70240"
          },
          "secondary_color": {
            "type": "string",
            "example": "#BED600"
          },
          "accent_color": {
            "type": "string",
            "example": "#0098DB"
          },
          "company_name": {
            "type": "string",
            "example": "Storage Dashboard"
          },
          "timezone": {
            "type": "string",
            "example": "Europe/Berlin"
          },
          "max_logs_per_system": {
            "type": "integer",
            "example": 1000
          },
          "log_retention_days": {
            "type": "integer",
            "example": 30
          },
          "min_log_level": {
            "type": "string",
            "enum": [
              "DEBUG",
              "INFO",
              "WARNING",
              "ERROR",
              "CRITICAL"
            ]
          },
          "dashboard_refresh_interval": {
            "type": "integer",
            "example": 5
          },
          "pure1_display_name": {
            "type": "string",
            "nullable": true
          },
          "pure1_app_id": {
            "type": "string",
            "nullable": true
          },
          "pure1_private_key": {
            "type": "string",
            "nullable": true
          },
          "pure1_private_key_passphrase": {
            "type": "string",
            "nullable": true
          },
          "pure1_public_key": {
            "type": "string",
            "nullable": true
          },
          "proxy_http": {
            "type": "string",
            "nullable": true
          },
          "proxy_https": {
            "type": "string",
            "nullable": true
          },
          "proxy_no_proxy": {
            "type": "string",
            "nullable": true
          },
          "logo_filename": {
            "type": "string",
            "nullable": true
          },
          "logo_data": {
            "type": "string",
            "nullable": true,
            "description": "Logo als Base64-kodierter String"
          }
        }
      },
      "BackupSystem": {
        "type": "object",
        "description": "Storage-System-Eintrag in einer Backup-Datei",
        "properties": {
          "name": {
            "type": "string"
          },
          "vendor": {
            "type": "string",
            "enum": [
              "pure",
              "netapp-ontap",
              "netapp-storagegrid",
              "dell-datadomain"
            ]
          },
          "ip_address": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "api_username": {
            "type": "string",
            "nullable": true
          },
          "api_password": {
            "type": "string",
            "nullable": true
          },
          "api_token": {
            "type": "string",
            "nullable": true
          },
          "enabled": {
            "type": "boolean"
          },
          "cluster_type": {
            "type": "string",
            "nullable": true
          },
          "node_count": {
            "type": "integer",
            "nullable": true
          },
          "site_count": {
            "type": "integer",
            "nullable": true
          },
          "dns_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "all_ips": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pure1_array_name": {
            "type": "string",
            "nullable": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "group": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "BackupCertificate": {
        "type": "object",
        "description": "Zertifikat-Eintrag in einer Backup-Datei",
        "properties": {
          "name": {
            "type": "string"
          },
          "certificate_type": {
            "type": "string"
          },
          "certificate_pem": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "BackupTagGroup": {
        "type": "object",
        "description": "Tag-Gruppe mit zugehörigen Tags in einer Backup-Datei",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "BackupPayload": {
        "type": "object",
        "description": "Vollständige Backup-Datei des Storage Dashboards",
        "required": [
          "backup_version",
          "backup_date",
          "backup_type"
        ],
        "properties": {
          "backup_version": {
            "type": "string",
            "example": "1.0",
            "description": "Version des Backup-Formats"
          },
          "backup_date": {
            "type": "string",
            "format": "date-time",
            "description": "Erstellungszeitpunkt des Backups (UTC ISO 8601)"
          },
          "backup_type": {
            "type": "string",
            "enum": [
              "full"
            ],
            "description": "Typ des Backups"
          },
          "settings": {
            "$ref": "#/components/schemas/BackupSettings"
          },
          "systems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BackupSystem"
            },
            "description": "Alle konfigurierten Storage-Systeme inkl. Zugangsdaten"
          },
          "certificates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BackupCertificate"
            },
            "description": "Alle SSL-Zertifikate"
          },
          "tag_groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BackupTagGroup"
            },
            "description": "Alle Tag-Gruppen mit ihren Tags"
          }
        }
      },
      "SystemsExport": {
        "type": "object",
        "description": "Export-Datei für Storage-Systeme (ohne Zugangsdaten)",
        "properties": {
          "export_date": {
            "type": "string",
            "format": "date-time",
            "description": "Erstellungszeitpunkt des Exports"
          },
          "systems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BackupSystem"
            }
          }
        }
      }
    }
  }
}